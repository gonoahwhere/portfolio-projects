{
  "name": "Jawva",
  "version": "1.0.0",
  "description": "A custom IDE built with Electron and Monaco Editor",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --inspect",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "cleanup-build": "node cleanup-build.js"
  },
  "keywords": [
    "ide",
    "editor",
    "electron"
  ],
  "author": "Noah",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0"
  },
  "build": {
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "appId": "com.noah-ide.app",
    "productName": "Jawva",
    "artifactName": "${productName}.${ext}",
    "files": [
      "about.css",
      "about.html",
      "about.js",
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "tabs.css",
      "workspace-styles.css",
      "assets/**"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/pinkshark.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/pinkshark.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/pinkshark.png"
    }
  }
}
